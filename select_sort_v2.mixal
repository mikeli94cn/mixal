* constant area
      ORIG 1000
SIZE  CON 7
ZERO  CON 0
ONE   CON 1
* variable area
      ORIG 2000
ARR   CON 7
      CON 2
      CON 4
      CON 6
      CON 1
      CON 8
      CON 5
      CON 3
TEMP  CON 0
* program area
* rI1:outer loop
* rI2:inner loop
* rI3:min index
* rA:min value
* rX:temp store arr[i-1], when exchange
      ORIG 3000
START LD1 ZERO
OUTLP ST1 TEMP
      LD2 TEMP
      INC2 1
      LD3 TEMP
      LDA ARR,3
INNLP CMPA ARR,2
      JG CHMIN
CONTU INC2 1
      CMP2 SIZE
      JLE INNLP
OUTHD LDX ARR,1 
      STA ARR,1
      STX ARR,3      
      INC1 1
      CMP1 SIZE
      JL OUTLP
      HLT
CHMIN ST2 TEMP
      LD3 TEMP
      LDA ARR,3
      JMP CONTU
END   END START
